{
  "name": "mini-agent",
  "version": "0.1.1",
  "private": true,
  "description": "A small modular coding agent harness compatible with model-router.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mini-agent": "./bin/mini-agent.js"
  },
  "scripts": {
    "build": "bun x tsc",
    "start": "bun run dist/start.js",
    "dev": "bun run src/start.ts",
    "test": "bun test",
    "check": "bun x tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "concolor": "^1.1.4",
    "openai": "^4.86.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
